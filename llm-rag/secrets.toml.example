# Copy this file to secrets.toml (next to config.toml) and fill in the values
# you actually use. All fields are optional — comment out or delete any unused
# entries. The loader silently runs with no secrets if this file is absent on
# the default search path; features that need a secret will error at use-time.
#
# After creating the real file, restrict its permissions:
#   chmod 600 secrets.toml
# The loader logs a warning if the file is group/world-accessible.

# Anthropic API key for the cloud LLM provider.
# Get one at https://console.anthropic.com/settings/keys
# anthropic_api_key = "sk-ant-api03-REPLACE-ME"
