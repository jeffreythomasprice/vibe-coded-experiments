{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserSummary",
  "type": "object",
  "required": ["id", "username", "is_admin", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "username": {
      "type": "string"
    },
    "is_admin": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
