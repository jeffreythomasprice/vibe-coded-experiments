{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Player",
  "description": "A chess player, either human or AI",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/PlayerKind"
    }
  },
  "definitions": {
    "PlayerKind": {
      "type": "string",
      "enum": [
        "human",
        "ai"
      ]
    }
  }
}