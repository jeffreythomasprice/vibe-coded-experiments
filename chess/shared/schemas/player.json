{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Player",
  "description": "A chess player, either human or AI",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/PlayerKind"
    },
    "ai_engine": {
      "type": "string",
      "description": "AI engine identifier. Only meaningful when kind is 'ai'."
    },
    "ai_params": {
      "type": "object",
      "description": "Parameters for the AI engine. Keys are parameter names, values are string representations.",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "PlayerKind": {
      "type": "string",
      "enum": [
        "human",
        "ai"
      ]
    }
  }
}