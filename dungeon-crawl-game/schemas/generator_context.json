{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeneratorContext",
  "description": "A collection of context entries used to guide LLM generation of game objects.",
  "type": "object",
  "required": [
    "name",
    "entries"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ContextEntry"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ContextEntry": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "string",
          "enum": [
            "all",
            "player",
            "room",
            "item",
            "event"
          ],
          "default": "all"
        }
      },
      "additionalProperties": false
    }
  }
}