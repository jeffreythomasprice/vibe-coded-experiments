{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Item",
  "description": "An item that can be found, carried, or used in the dungeon.",
  "type": "object",
  "required": ["name", "description", "effects"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "effect.json#/definitions/Effect"
      }
    },
    "droppable": {
      "type": "boolean",
      "default": true
    },
    "tradable": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false
}
