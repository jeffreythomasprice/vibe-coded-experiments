{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Player",
  "description": "A player character with GURPS-style stats.",
  "type": "object",
  "required": [
    "name",
    "description",
    "stats"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "stats": {
      "$ref": "#/definitions/PlayerStats"
    },
    "color": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "PlayerStats": {
      "type": "object",
      "required": [
        "strength",
        "speed",
        "intelligence",
        "sanity"
      ],
      "properties": {
        "strength": {
          "type": "integer",
          "default": 10
        },
        "speed": {
          "type": "integer",
          "default": 10
        },
        "intelligence": {
          "type": "integer",
          "default": 10
        },
        "sanity": {
          "type": "integer",
          "default": 10
        }
      },
      "additionalProperties": false
    }
  }
}