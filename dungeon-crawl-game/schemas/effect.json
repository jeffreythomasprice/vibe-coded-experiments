{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "StatName": {
      "type": "string",
      "enum": ["strength", "speed", "intelligence", "sanity"]
    },
    "Effect": {
      "type": "object",
      "required": [
        "trigger_type",
        "result_type",
        "target"
      ],
      "properties": {
        "trigger_type": {
          "type": "string",
          "enum": [
            "stat_check",
            "always",
            "random_roll"
          ]
        },
        "trigger_stat": {
          "$ref": "#/definitions/StatName"
        },
        "trigger_outcomes": {
          "type": "object",
          "properties": {
            "success": {
              "type": "string"
            },
            "failure": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "result_type": {
          "type": "string",
          "enum": [
            "modify_stat",
            "physical_damage",
            "mental_damage",
            "teleport",
            "lose_turn"
          ]
        },
        "result_stat": {
          "$ref": "#/definitions/StatName"
        },
        "result_amount": {
          "type": "integer"
        },
        "target": {
          "type": "string",
          "enum": [
            "self",
            "room",
            "all"
          ]
        },
        "timing_type": {
          "type": "string",
          "enum": [
            "immediate",
            "duration",
            "delayed"
          ],
          "default": "immediate"
        },
        "timing_turns": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}