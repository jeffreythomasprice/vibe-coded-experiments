{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "description": "An event that can occur in the dungeon.",
  "type": "object",
  "required": [
    "name",
    "description",
    "effects",
    "magnitude"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "effect.json#/definitions/Effect"
      },
      "minItems": 1
    },
    "magnitude": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}