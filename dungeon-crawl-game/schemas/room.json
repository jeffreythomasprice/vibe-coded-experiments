{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Room",
  "description": "A room in the dungeon with doors and optional entry events.",
  "type": "object",
  "required": ["description", "door_config", "magnitude"],
  "properties": {
    "description": {
      "type": "string"
    },
    "magnitude": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "door_config": {
      "$ref": "#/definitions/DoorConfig"
    },
    "entry_event": {
      "$ref": "#/definitions/RoomEvent"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DoorConfig": {
      "type": "object",
      "required": ["count", "arrangement"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "arrangement": {
          "type": "string",
          "enum": ["dead_end", "straight", "corner", "t_intersection", "crossroads"]
        }
      },
      "additionalProperties": false
    },
    "RoomEvent": {
      "type": "object",
      "required": ["name", "description", "effects"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "effect.json#/definitions/Effect"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
