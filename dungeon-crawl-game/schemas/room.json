{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Room",
  "description": "A room in the dungeon with doors and optional content.",
  "type": "object",
  "required": [
    "name",
    "description",
    "door_config",
    "magnitude"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "magnitude": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "door_config": {
      "$ref": "#/definitions/DoorConfig"
    },
    "content": {
      "oneOf": [
        {
          "$ref": "item.json"
        },
        {
          "$ref": "event.json"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DoorConfig": {
      "type": "object",
      "required": [
        "arrangement"
      ],
      "properties": {
        "arrangement": {
          "type": "string",
          "enum": [
            "dead_end",
            "straight",
            "corner",
            "t_intersection",
            "crossroads"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}