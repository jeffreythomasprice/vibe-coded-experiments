{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EvoArt",
  "version": "0.1.0",
  "identifier": "com.evoart.app",
  "build": {
    "beforeDevCommand": "bun run generate && bun run dev",
    "beforeBuildCommand": "bun run generate && bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EvoArt",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
