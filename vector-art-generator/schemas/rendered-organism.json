{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rendered-organism",
  "title": "RenderedOrganism",
  "description": "An organism rendered as SVG for display in the frontend grid",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "UUID of the genome"
    },
    "svg": {
      "type": "string",
      "description": "Rendered SVG markup"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "description": "Generation number this organism belongs to"
    }
  },
  "required": ["id", "svg", "generation"],
  "additionalProperties": false
}
