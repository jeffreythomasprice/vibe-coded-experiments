# Copy this file to one of, in descending order of preference:
#   the path given to --config
#   ./config.toml
#   <directory containing the image-gen binary>/config.toml
#   $XDG_CONFIG_HOME/image-gen/config.toml (usually ~/.config/image-gen/config.toml)

# Tracing filter, same syntax as RUST_LOG. When RUST_LOG is set it wins over this.
log_filter = "warn,image_gen=trace"

# Where rotating log files are written; console output is unaffected.
log_dir = "/tmp/image-gen/logs"

# Roll the log at this size or at the start of each UTC day, whichever comes
# first, keeping this many files total (the one being written included).
log_max_bytes = 104857600
log_max_files = 15

# Where model weights are downloaded and cached.
models_dir = "/tmp/image-gen"

# Named bundles of `generate` arguments. `--preset flux` is the same as typing
# each key below as its --flag. `--preset` is repeatable and combines left to
# right (`--preset flux --preset eval` applies both); a key both presets set logs
# a warning and keeps the later preset's value. Anything you also pass on the
# command line wins over every preset, also with a warning. Keys are the long
# flag name in snake_case; values use the same syntax the flag does. Every
# generate flag is allowed except the per-invocation ones: the prompt, --output,
# --copies, --show, --json and --seed. Note floats need a decimal point:
# cfg_scale = 1.0, not 1.

[presets.flux]
diffusion_model = "city96/FLUX.1-dev-gguf:flux1-dev-F16.gguf"
clip_l = "comfyanonymous/flux_text_encoders:clip_l.safetensors"
t5xxl = "comfyanonymous/flux_text_encoders:t5xxl_fp8_e4m3fn.safetensors"
vae = "unsloth/FLUX.1-dev:ae.safetensors"
weight_type = "q8_0"

[presets.turbo]
model = "stabilityai/sd-turbo"
steps = 4
cfg_scale = 1.0
guidance = 0.0

# Qwen-Image-2.1 needs three separate weight files — the diffusion model alone
# is not enough. `--model`/`model =` (a single combined checkpoint) is the
# wrong flag for this; use `diffusion_model` as below. `vae` MUST be
# `qwen_image_2.1_vae_bf16.safetensors` specifically: earlier Qwen-Image and
# Wan 2.2 VAE weights are not interchangeable with it. `text_encoder` is the
# Qwen3-VL-8B-Instruct text encoder (GGUF works); add `vision_encoder` (its
# mmproj file) too if you also want image-editing mode.
[presets.qwen]
diffusion_model = "leejet/Qwen-Image-2.1-GGUF:qwen_image_2.1-Q8_0.gguf"
vae = "Comfy-Org/Qwen-Image-2.1:vae/qwen_image_2.1_vae_bf16.safetensors"
text_encoder = "Qwen/Qwen3-VL-8B-Instruct-GGUF:Qwen3VL-8B-Instruct-Q4_K_M.gguf"
cfg_scale = 6.0
sampler = "euler"

# Everything --eval and --rewrite need, bundled so `--preset eval` turns both on
# with one flag. Four model overrides exist, all falling back to [llm].model
# when unset: rewrite_model (text only), vqa_model (vision), caption_model
# (vision) and judge_model (text only, judges the caption text against the
# prompt). None of the four has a built-in default, and neither does
# [llm].model itself: whichever role you actually use (--rewrite and/or --eval)
# must resolve a model from an explicit flag, a preset, or [llm].model below,
# or that run fails. Only vqa_model/caption_model need a vision-capable model,
# so they're set explicitly here; rewrite_model and judge_model are left to
# fall back to [llm].model below.
# TIT-Score is slow (two LLM calls per image, one a 250-350 word caption), so
# raise [llm.ollama].timeout_secs below if you use it.
[presets.eval]
eval = ["vqa", "tit"]
rewrite = "auto"
rewrite_threshold = 300
eval_max_px = 512
vqa_model = "qwen3-vl:4b"
caption_model = "qwen3-vl:4b"

# LLM backend, for prompt rewriting and automated evaluation (VQAScore,
# TIT-Score). "ollama" is the only backend right now. `model` here is the
# fallback used by rewrite_model/vqa_model/caption_model/judge_model above
# when they're not set individually; leave it unset and every role must be
# set individually instead, or that role fails. When set, keep it a plain
# text model (rewrite and judging never see images) and override
# vqa_model/caption_model with a vision model, e.g. qwen2.5vl/qwen3-vl or
# gemma3, wherever images are involved.
[llm]
backend = "ollama"
model = "qwen3:4b"
max_turns = 8

[llm.ollama]
host = "localhost"
port = 11434
# TIT-Score's caption call can run past the default 120s on a slow VLM; 300 is a
# safer floor once --eval tit is in use.
timeout_secs = 300
# A model missing locally is pulled automatically before the chat request is
# retried. This bounds silence during that pull, not its total duration: a
# multi-gigabyte download can run far longer than this and keep going as long as
# it keeps making progress, including through Ollama's quiet checksum-verification
# pass on a very large model.
pull_stall_timeout_secs = 600

# The sd-server sidecar that actually runs generation (see `image-gen server
# --help`). The first `generate` with a given set of model flags downloads a
# matching release and spawns it as a background daemon; later runs with the
# same flags reuse that process instead of reloading the model. Changing any
# model path, --weight-type, --backend, --threads, --vae-tiling, or
# --flash-attn restarts it.
[sd_server]
host = "127.0.0.1"
port = 1234
# Which prebuilt release asset to download: "vulkan", "cpu", or "rocm". There
# is no "cuda" asset for Linux (Windows-only upstream); --backend cuda fails
# regardless of this setting.
backend = "vulkan"
# A specific upstream tag (e.g. "master-890-74988b2"), or "latest" to resolve
# the newest release each time a download is actually needed. A literal tag
# that's already downloaded needs no network access at all.
release_tag = "latest"
auto_download = true
# Where downloaded releases are extracted, one directory per tag.
server_dir = "/tmp/image-gen/sd-server"
# Daemon lock file and status record (see `image-gen server status`).
state_dir = "/tmp/image-gen/run"
# How long to wait for the daemon to report ready after spawning it — generous
# by default since loading a large checkpoint can take minutes.
startup_timeout_secs = 300
request_timeout_secs = 1800
poll_interval_ms = 250
