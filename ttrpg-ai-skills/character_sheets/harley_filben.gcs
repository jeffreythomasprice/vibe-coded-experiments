          {"state": "Tired", "expression": "round($fp/3)", "explanation": "Move, Dodge and ST are halved (B426)", "ops": ["halve_move", "halve_dodge", "halve_st"]},
          {"state": "Tiring", "expression": "$fp-1"},
          {"state": "Rested", "expression": "$fp"}
        ]
      },
