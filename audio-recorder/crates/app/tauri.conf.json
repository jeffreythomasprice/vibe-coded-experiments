{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Recorder",
  "version": "0.1.0",
  "identifier": "dev.audio-recorder.desktop",
  "build": {
    "beforeDevCommand": "cd ui && trunk serve",
    "beforeBuildCommand": "cd ui && trunk build --release",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Audio Recorder",
        "width": 900,
        "height": 640,
        "minWidth": 600,
        "minHeight": 420
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/icon.png"]
  }
}
