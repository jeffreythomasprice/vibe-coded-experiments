{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "devices"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "devices": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/DeviceAnalysis"
      }
    }
  },
  "definitions": {
    "DeviceAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "loudness_lufs",
        "peak"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "loudness_lufs": {
          "type": [
            "number",
            "null"
          ]
        },
        "peak": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
