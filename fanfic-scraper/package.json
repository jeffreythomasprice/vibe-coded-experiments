{
    "name": "fanfic-scraper",
    "module": "src/index.ts",
    "scripts": {
        "start": "bun run src/index.ts",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write 'src/**/*.ts' '*.json' '*.js'",
        "format:check": "prettier --check 'src/**/*.ts' '*.json' '*.js'"
    },
    "type": "module",
    "private": true,
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "latest",
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "prettier": "^3.8.1",
        "typescript-eslint": "^8.57.1"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "cheerio": "^1.2.0",
        "commander": "^14.0.3",
        "fuse.js": "^7.1.0",
        "smol-toml": "^1.6.0"
    }
}
