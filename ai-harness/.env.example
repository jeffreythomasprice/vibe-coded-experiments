# ai-harness environment variables.
#
# Copy to `.env` in the repo root (it's already in .gitignore, so it never
# gets committed). Loaded automatically on startup and by the live LLM
# tests — see README.md's "Environment variables" section. A variable
# already set in your shell takes precedence over this file.
#
# Both keys are optional: only set the ones for the providers you actually
# use. These are the default `api_key_env` names from config.example.toml —
# if you rename `[llm.anthropic] api_key_env` / `[llm.openai] api_key_env`
# in your config, set that name here instead.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
