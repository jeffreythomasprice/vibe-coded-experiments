# Loaded automatically by `cargo run -p server` (see config.rs) so the server works locally with
# no exported variables. Real process env always wins -- dev.sh's inline overrides and k8s's
# injected env are unaffected. No real secrets: these are dynamodb-local's throwaway fixed
# credentials, and SESSION_SECRET below is a fixed dev-only value, not the production signing key
# (see terraform/sessions.tf and CLAUDE.md's "Server hosting" section for that one).
DYNAMODB_ENDPOINT=http://127.0.0.1:8002
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
SESSION_SECRET=local-dev-session-secret
