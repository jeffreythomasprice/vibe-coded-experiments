{
  "$defs": {
    "RoomSummary": {
      "properties": {
        "display_name": {
          "$ref": "#/$defs/RoomName"
        },
        "member_count": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "display_name",
        "member_count",
        "updated_at"
      ],
      "type": "object"
    },
    "RoomList": {
      "properties": {
        "rooms": {
          "items": {
            "$ref": "#/$defs/RoomSummary"
          },
          "type": "array"
        },
        "next_cursor": {
          "description": "Opaque continuation token: pass it back as `cursor` for the next page. Absent when this was the last page.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "rooms"
      ],
      "type": "object"
    }
  }
}
